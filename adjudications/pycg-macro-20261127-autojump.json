      "edge": [
        "autojump_argparse._AttributeHolder.__repr__",
        "<builtin>.repr"
      ],
      "kind": "false_negative",
      "disposition": "benchmark_defect_or_omission",
      "reviewer": "claude:pycg-review-20261127",
      "rationale": "repr(arg) runs only for items of self._get_args(). _AttributeHolder._get_args always returns [] and no class in the file overrides it (the only definition is line 156), so the call never executes. The %r formatting nearby is not a call to builtin repr.",
      "evidence_refs": [
        "corpus:projects/autojump/bin/autojump_argparse.py:147",
        "corpus:projects/autojump/bin/autojump_argparse.py:156"
      ]
    },
