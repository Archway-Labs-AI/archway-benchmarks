      "edge": [
        "autojump_utils.unico",
        "<builtin>.isinstance"
      ],
      "kind": "false_negative",
      "disposition": "benchmark_defect_or_omission",
      "reviewer": "claude:pycg-review-20261127",
      "rationale": "Unreachable under Python 3. is_python2() returns sys.version_info[0] == 2, so 'is_python2() and not isinstance(...)' short-circuits and isinstance is never called.",
      "evidence_refs": [
        "corpus:projects/autojump/bin/autojump_utils.py:96",
        "corpus:projects/autojump/bin/autojump_utils.py:209"
      ]
