      "edge": [
        "autojump_argparse.ArgumentParser._print_message",
        "<**PyFile**>.write"
      ],
      "kind": "false_positive",
      "disposition": "adapter_representation_mismatch",
      "reviewer": "claude:pycg-review-20261127",
      "rationale": "file.write(message) writes to a text stream: the file argument, or sys.stderr by default, which print_help passes as sys.stdout. The benchmark's sys.stdout.write from _print_message names the same call.",
      "evidence_refs": [
        "analysis_evidence:semantic_call_edge_evidence",
        "corpus:projects/autojump/bin/autojump_argparse.py:2437",
        "paired_expected:sys.stdout.write"
      ]
    },
